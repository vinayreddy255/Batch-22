<script>
    string_1 = "hello test";
    result = {};
    //output: hos
    for (let i = 0; i < string_1.length; i++) {
        let char = string_1[i];
        if (result[char]) {
            result[char]++;
        } else {
            result[char] = 1;
        }
    }
    console.log(result);
    let nonRepeatedChars = "";
    for (let char in result) {
        if (result[char] == 1 && char !== " ") {
            nonRepeatedChars += char;
        }
    }
    console.log("Non-repeated characters:", nonRepeatedChars);
</script>
